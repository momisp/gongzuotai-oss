pipeline {
  agent any
  
  // Windows 环境不需要 tools，如果 Jenkins 服务器上已安装 Node.js
  // 如果需要使用 Jenkins 配置的 Node.js 工具，取消下面注释并修改工具名称
  // tools {
  //   nodejs "NodeJS-18"  // 修改为你在 Jenkins 中配置的 Node.js 工具名称
  // }
  
  stages {
    stage('Install Apifox CLI') {
      steps {
        script {
          echo '正在安装 Apifox CLI...'
          // Windows 使用 bat 而不是 sh
          bat 'npm install -g apifox-cli'
          bat 'apifox --version'
        }
      }
    }
    
    stage('Running Test Scenario') {
      steps {
        script {
          echo '开始执行接口自动化测试...'
          // Windows 使用 bat 而不是 sh
          bat 'apifox run https://api.apifox.com/api/v1/projects/7042956/api-test/ci-config/507917/detail?token=xr1NaF2Dt6LEVP7Eac0cNT -r html,cli'
        }
      }
    }
  }
  
  post {
    always {
      echo '测试执行完成'
    }
    
    success {
      echo '✅ 测试执行成功！'
    }
    
    failure {
      echo '❌ 测试执行失败！'
    }
  }
}
