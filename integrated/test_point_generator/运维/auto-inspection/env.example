# 复制为 .env（与本目录下的 config.yaml 配合使用）
# 勿将 .env 提交到 Git 或发给他人

# RAM 用户 AccessKey（主账号也可，但不建议）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 若 config 里写了第二账号，可另设：
# ALIBABA_CLOUD_ACCESS_KEY_ID_2=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET_2=

# 风险项推送钉钉（与「钉钉报告推送」一样，用群机器人 Webhook）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
