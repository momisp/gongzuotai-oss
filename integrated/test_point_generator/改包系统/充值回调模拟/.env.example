# 复制为 .env 后填写（勿提交 .env）

# HTTP 监听地址：127.0.0.1 仅本机；0.0.0.0 允许同一局域网内其他电脑用浏览器访问（需在 Windows 防火墙放行 PORT）
HOST=0.0.0.0
PORT=3780

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=game_lx
# 可选业务库（页面下拉）：game_lx=龙翔，game_yq=游趣，game_ly=龙耀（查库 dev_example_com）
# 查询时按页面选择使用 库名.tab_spend（龙耀实际查 dev_example_com），DB_NAME 仅作连接默认库

# 回调根域名
# 龙翔默认用 CALLBACK_ORIGIN；游趣默认 http://yq.example.com；龙耀默认 http://ly.example.com
CALLBACK_ORIGIN=http://dev.example.com
# CALLBACK_ORIGIN_YQ=http://yq.example.com
# CALLBACK_ORIGIN_LX2=http://dev.example.com
# CALLBACK_ORIGIN_LY=http://ly.example.com

# 可选：支付宝/微信「原始异步通知」路径（相对回调域名）。
# 不配则关单等状态仍走 supper_pay_callback，并在 JSON 里附带 trade_status / trade_state。
# 若研发提供了真实 notify 入口，填上后支付宝类状态会优先打该地址（form 表单）。
# ALIPAY_NOTIFY_PATH=/callback/Notify/alipay_notify
# WECHAT_NOTIFY_PATH=/callback/Notify/wxpay_notify
